{
  "name": "usage-monitor",
  "private": true,
  "version": "0.2.1",
  "description": "Native macOS menu-bar app tracking Claude, Codex, and Cursor usage allowances",
  "author": "Adam Higgins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adampeterhiggins/usage-monitor.git"
  },
  "homepage": "https://github.com/adampeterhiggins/usage-monitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run check:workflows && npm run check:boundaries",
    "release:prepare": "node scripts/set-version.mjs",
    "release:manifest": "node scripts/build-update-manifest.mjs",
    "check:workflows": "node scripts/lint-workflows.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev:mock": "vite --mode mock",
    "generate:css": "esbuild scripts/generate-ui-palette-css.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-ui-css.mjs && node node_modules/.cache/gen-ui-css.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/hashes": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
