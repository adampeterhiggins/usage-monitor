{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Monitor",
  "version": "0.1.6",
  "identifier": "com.adamhiggins.usage-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Usage Monitor",
        "width": 820,
        "height": 480,
        "minWidth": 560,
        "minHeight": 280,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwOUIwNzFCOTEwRDJFRTUKUldUbExnMlJHd2ViUUJQZHFuNyttdnRTWW5yT3JvRkN4Q3hUOUQ3cWJXTk9KblNWdC9SU0x3aWYK",
      "endpoints": [
        "https://raw.githubusercontent.com/adampeterhiggins/usage-monitor-native/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
